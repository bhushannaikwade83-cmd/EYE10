# =============================================================================
# EYE10 — Elga Cloud / cPanel environment variable checklist
# Use these names in cPanel's Node.js app environment variables screen.
# After changing any VITE_* / public build values, rebuild the frontend.
# =============================================================================

# --- Supabase public values (used in the browser build) ---
# Set either the VITE_* keys directly, or set SUPABASE_URL + SUPABASE_ANON_KEY
# and let vite.config.js inject them at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-side Postgres URL (do not expose to browser code):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# --- Storage backend (client) ---
# Keep blank for same-origin /api on Elga. Only set VITE_B2_API_BASE_URL if the API
# is hosted on another origin.
VITE_STORAGE_BACKEND=b2
VITE_B2_PRIVATE_BUCKET=true
VITE_B2_API_BASE_URL=

# --- Optional site features (client) ---
VITE_GOOGLE_REVIEW_URL=
VITE_GOOGLE_REVIEWS_API_URL=
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
VITE_API_BASE_URL=

# --- EmailJS runtime values (server-side only) ---
# EmailJS account security must allow non-browser API use.
# Template "To email" should be {{to_email}}.
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_SUBJECT_PREFIX=EYE10

# --- B2 + admin API runtime secrets (server-side only) ---
SUPABASE_SERVICE_ROLE_KEY=
B2B_BUCKET_NAME=
B2B_BUCKET_ID=
B2B_KEY_ID=
B2B_APPLICATION_KEY=
B2B_FILE_BASE_URL=
