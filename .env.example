# Supabase (client — Vite embeds VITE_* at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backblaze B2 (optional; use with Vercel serverless api/b2-storage.js) ---
# Client: b2 = presigned uploads via /api/b2-storage; omit or use supabase for Supabase Storage.
# VITE_STORAGE_BACKEND=supabase
# VITE_STORAGE_BACKEND=b2
# Private bucket: storefront uses presigned read URLs via /api/b2-storage (presignGet). Set bucket to private in Backblaze.
# VITE_B2_PRIVATE_BUCKET=true
# Optional: if the admin app calls a different API origin (rare), set it (no trailing slash).
# VITE_B2_API_BASE_URL=

# Server-only (Vercel Environment Variables — never commit real values):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  # for api/b2-storage.js JWT verification; never expose to the browser
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=your-bucket-name
# B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_S3_REGION=us-west-004
# B2_FILE_BASE_URL=https://f000.backblazeb2.com/file/your-bucket-name
# In Backblaze: allow CORS on the bucket for your site origin so the browser can PUT to the presigned URL.

# Optional Google reviews source (use one)
VITE_GOOGLE_REVIEW_URL=https://maps.app.goo.gl/vS9y8nECv9gTCuAE6
VITE_GOOGLE_REVIEWS_API_URL=
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=

# Email coupons (Brevo Transactional Email API) - server-side only
# Get API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EYE10
BREVO_SUBJECT_PREFIX=EYE10
