# Supabase public settings (browser build)
# Vite embeds VITE_* values at build time. If your host only provides SUPABASE_URL +
# SUPABASE_ANON_KEY, vite.config.js maps those into the client bundle during build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional server-side Postgres URL (never expose to browser code):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fvzqldjtlfgnekucntqe.supabase.co:5432/postgres

# Storage backend (client)
# VITE_STORAGE_BACKEND=supabase
VITE_STORAGE_BACKEND=b2
# For private B2 bucket + presigned GET in storefront:
VITE_B2_PRIVATE_BUCKET=true
# Optional (if API runs on a different origin):
VITE_B2_API_BASE_URL=

# Server-only runtime secrets (Node app / hosted /api routes)
# Reuse SUPABASE_URL above for the admin API runtime.
SUPABASE_SERVICE_ROLE_KEY=
B2B_BUCKET_NAME=
B2B_BUCKET_ID=
B2B_KEY_ID=
B2B_APPLICATION_KEY=
B2B_FILE_BASE_URL=

# Optional Google reviews source (use one)
VITE_GOOGLE_REVIEW_URL=https://maps.app.goo.gl/vS9y8nECv9gTCuAE6
VITE_GOOGLE_REVIEWS_API_URL=
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
# Optional — only if the site and API are on different origins (rare).
# Leave empty for normal dev: `npm run dev` serves /api on the same port (3000).
# VITE_API_BASE_URL=

# Email coupons (EmailJS REST API — used by /api/send-coupon-email)
# Account → Security: enable “Allow EmailJS API for non-browser applications”.
# Dashboard: https://www.emailjs.com/ — create Email Service + Template.
# Template SETTINGS: "To email" must be {{to_email}} (customer from site). Not a fixed admin address.
# Body: {{coupon_code}}, {{offer_label}}, {{to_name}}, etc.
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_SUBJECT_PREFIX=EYE10
# Legacy dev names (optional): VITE_EMAILJS_PUBLIC_KEY, VITE_EMAILJS_PRIVATE_KEY, VITE_EMAILJS_SERVICE_ID, VITE_EMAILJS_TEMPLATE_ID
