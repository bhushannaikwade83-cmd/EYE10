# Supabase (client — Vite embeds VITE_* at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional server-side Postgres URL (never expose to browser code):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fvzqldjtlfgnekucntqe.supabase.co:5432/postgres

# Storage backend (client)
# VITE_STORAGE_BACKEND=supabase
VITE_STORAGE_BACKEND=b2
# For private B2 bucket + presigned GET in storefront:
VITE_B2_PRIVATE_BUCKET=true
# Optional (if API runs on a different origin):
VITE_B2_API_BASE_URL=

# Server-only (for /api/b2-storage on Vercel) — Backblaze B2 Native API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
B2B_BUCKET_NAME=
B2B_BUCKET_ID=
B2B_KEY_ID=
B2B_APPLICATION_KEY=
B2B_FILE_BASE_URL=

# Optional Google reviews source (use one)
VITE_GOOGLE_REVIEW_URL=https://maps.app.goo.gl/vS9y8nECv9gTCuAE6
VITE_GOOGLE_REVIEWS_API_URL=
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
# Optional — only if the site and API are on different origins (rare).
# Leave empty for normal dev: `npm run dev` serves /api on the same port (3000).
# VITE_API_BASE_URL=

# Email coupons (Brevo Transactional Email API) - server-side only
# Get API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EYE10
BREVO_SUBJECT_PREFIX=EYE10
