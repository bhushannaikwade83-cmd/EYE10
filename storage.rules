rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /catalogue/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    function isHomeBannerMediaType() {
      let ct = request.resource.contentType;
      return ct == 'image/jpeg'
        || ct == 'image/png'
        || ct == 'video/mp4'
        || ct == 'video/webm'
        || ct == 'video/quicktime';
    }

    match /home-banners/{bannerId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 45 * 1024 * 1024
        && isHomeBannerMediaType();
      allow delete: if isAdmin();
    }
  }
}
