# =============================================================================
# EYE10 — paste into Vercel: Project → Settings → Environment Variables
# Enable "Production" (and "Preview" if you want previews to match).
# After changing any VITE_* line: Deployments → Redeploy (build embeds VITE_*).
# Do NOT commit a filled copy of this file. Copy locally, fill, paste keys in Vercel.
# =============================================================================

# --- Supabase (client / Vite build) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional server-side Postgres URL (for backend jobs/ORM; do not expose in client):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fvzqldjtlfgnekucntqe.supabase.co:5432/postgres

# --- Storage backend (client) ---
# Use b2 to route admin uploads through /api/b2-storage.
VITE_STORAGE_BACKEND=b2
VITE_B2_PRIVATE_BUCKET=true
VITE_B2_API_BASE_URL=

# --- Optional site features (client) ---
VITE_GOOGLE_REVIEW_URL=
VITE_GOOGLE_REVIEWS_API_URL=
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
# Optional for local dev split origins (usually leave empty in Vercel).
VITE_API_BASE_URL=

# EmailJS (server — required for /api/send-coupon-email). https://www.emailjs.com/
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_SUBJECT_PREFIX=EYE10
# Template "To Email" should be {{to_email}}. Optional VITE_EMAILJS_* same values for local .env.

# --- Server-only (B2 upload API, native B2 auth) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
B2B_BUCKET_NAME=
B2B_BUCKET_ID=
B2B_KEY_ID=
B2B_APPLICATION_KEY=
B2B_FILE_BASE_URL=

# CLI helper (run locally after loading env vars):
# b2 account authorize "$B2B_KEY_ID" "$B2B_APPLICATION_KEY"
